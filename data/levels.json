{
  "schemaVersion": 1,
  "sources": [
    {
      "id": "rfc1812",
      "title": "Requirements for IP Version 4 Routers",
      "url": "https://www.rfc-editor.org/rfc/rfc1812.html#section-5.2.4.3",
      "section": "5.2.4.3",
      "claim": "Longest matching route and default forwarding"
    },
    {
      "id": "rfc1122",
      "title": "Requirements for Internet Hosts",
      "url": "https://www.rfc-editor.org/rfc/rfc1122.html#section-3.3.1.1",
      "section": "3.3.1.1–3.3.1.2",
      "claim": "Local and remote destination routing"
    },
    {
      "id": "rfc792",
      "title": "Internet Control Message Protocol",
      "url": "https://www.rfc-editor.org/rfc/rfc792.html",
      "section": "Echo or Echo Reply Message",
      "claim": "ICMP echo request and reply"
    },
    {
      "id": "vlan",
      "title": "Cisco Layer 2 Interfaces",
      "url": "https://www.cisco.com/c/en/us/td/docs/switches/datacenter/nexus9000/sw/7-x/interfaces/configuration/guide/b_Cisco_Nexus_9000_Series_NX-OS_Interfaces_Configuration_Guide_7x/configuring_layer_2_interfaces.html",
      "section": "Trunk and Access Ports and VLAN Traffic",
      "claim": "Access ports carry VLAN traffic"
    }
  ],
  "levels": [
    {
      "id": "level-1",
      "title": "First Alerts",
      "difficulty": 1,
      "outcome": "Identify a fault from direct evidence",
      "briefing": "Compare what should be configured with what the device actually reports. Example: if a port should be in VLAN 5 but reports VLAN 8, investigate that mismatch before changing a value that already matches.",
      "sources": [
        "vlan",
        "rfc1122"
      ],
      "rounds": [
        {
          "id": "1.1",
          "title": "Workstation offline",
          "alert": "HOST-07 cannot reach its gateway.",
          "path": "HOST-07 → SW-01 Gi0/7 → gateway 192.168.10.1",
          "evidence": [
            "HOST-07: 192.168.10.27/24; gateway 192.168.10.1 (expected 192.168.10.1)",
            "SW-01 Gi0/7: expected access VLAN 10; observed VLAN 20",
            "HOST-07 → 192.168.10.1: ping failed. Other path components are healthy."
          ],
          "fault": {
            "kind": "vlan",
            "target": "SW-01 Gi0/7",
            "expected": 10,
            "observed": 20
          },
          "choices": [
            {
              "id": "vlan",
              "diagnosis": "vlan",
              "target": "SW-01 Gi0/7",
              "value": 10,
              "label": "Wrong port VLAN → restore SW-01 Gi0/7 to VLAN 10"
            },
            {
              "id": "gateway",
              "diagnosis": "gateway",
              "target": "HOST-07",
              "value": "192.168.10.254",
              "label": "Wrong gateway → change HOST-07's default gateway",
              "why": "HOST-07 already has the expected gateway, 192.168.10.1. Compare the port's expected and observed VLAN."
            },
            {
              "id": "route",
              "diagnosis": "route",
              "target": "R1",
              "value": "default",
              "label": "Missing route → add a router default route",
              "why": "A default route does not fix the demonstrated local port VLAN mismatch. Compare the switch port values."
            }
          ],
          "hints": [
            "Compare expected and observed settings on the local path.",
            "The switch port is expected in VLAN 10 but reports VLAN 20.",
            "Select the VLAN mismatch and restore SW-01 Gi0/7 to VLAN 10."
          ],
          "sources": [
            "vlan",
            "rfc792"
          ],
          "observations": [
            {
              "kind": "vlan",
              "target": "SW-01 Gi0/7",
              "expected": 10,
              "observed": 20
            }
          ],
          "probes": [
            {
              "path": [
                "HOST-07",
                "SW-01",
                "192.168.10.1"
              ],
              "condition": "restored"
            },
            {
              "path": [
                "HOST-07",
                "127.0.0.1"
              ],
              "condition": "healthy"
            }
          ],
          "patchName": "Gatekeeper",
          "rack": {
            "target": "SW-01 Gi0/7",
            "servicePort": 6,
            "ports": [
              {
                "tag": "CAM-01",
                "vlan": 10
              },
              {
                "tag": "",
                "vlan": 10
              },
              {
                "tag": "DESK-02",
                "vlan": 10
              },
              {
                "tag": "",
                "vlan": 10
              },
              {
                "tag": "CAM-03",
                "vlan": 10
              },
              {
                "tag": "",
                "vlan": 10
              },
              {
                "tag": "HOST-07"
              },
              {
                "tag": "",
                "vlan": 10
              }
            ]
          }
        },
        {
          "id": "1.2",
          "title": "Remote network unreachable",
          "alert": "HOST-08 can reach its gateway but not a remote server.",
          "path": "HOST-08 → SW-02 → gateway 192.168.30.1 → remote 192.168.40.5",
          "evidence": [
            "HOST-08: 192.168.30.8/24; expected gateway 192.168.30.1; observed gateway 192.168.30.254",
            "Ping to 192.168.30.1 succeeds; ping to off-subnet 192.168.40.5 fails.",
            "SW-02 port expected and observed VLAN 30; gateway and remaining path are healthy."
          ],
          "fault": {
            "kind": "gateway",
            "target": "HOST-08",
            "expected": "192.168.30.1",
            "observed": "192.168.30.254"
          },
          "choices": [
            {
              "id": "gateway",
              "diagnosis": "gateway",
              "target": "HOST-08",
              "value": "192.168.30.1",
              "label": "Wrong gateway → set HOST-08 gateway to 192.168.30.1"
            },
            {
              "id": "vlan",
              "diagnosis": "vlan",
              "target": "SW-02",
              "value": 10,
              "label": "Wrong port VLAN → change SW-02 port VLAN",
              "why": "The port's observed and expected VLAN are both 30. Compare the gateway values for the remote destination."
            }
          ],
          "hints": [
            "For a remote destination, compare the configured gateway with the intended one.",
            "The host reports 192.168.30.254 but should use 192.168.30.1.",
            "Set HOST-08's gateway to 192.168.30.1."
          ],
          "sources": [
            "rfc1122",
            "vlan"
          ],
          "observations": [
            {
              "kind": "gateway",
              "target": "HOST-08",
              "expected": "192.168.30.1",
              "observed": "192.168.30.254"
            }
          ],
          "probes": [
            {
              "path": [
                "HOST-08",
                "SW-02",
                "192.168.30.1"
              ],
              "condition": "healthy"
            },
            {
              "path": [
                "HOST-08",
                "SW-02",
                "Gateway",
                "192.168.40.5"
              ],
              "condition": "restored"
            }
          ],
          "patchName": "Relay Scout"
        }
      ]
    },
    {
      "id": "level-2",
      "title": "Path Correlation",
      "difficulty": 2,
      "outcome": "Correlate evidence across devices",
      "briefing": "A successful test to one point narrows the search but does not prove the entire path. Example: if a host reaches its gateway but the router has no route to a remote network, investigate forwarding beyond the local LAN.",
      "sources": [
        "rfc1812",
        "rfc792"
      ],
      "rounds": [
        {
          "id": "2.1",
          "title": "Route missing",
          "alert": "HOST-09 reaches its gateway but cannot reach the remote server.",
          "path": "HOST-09 → R1 → 10.0.0.2 → 192.168.40.5",
          "evidence": [
            "HOST-09: 192.168.10.9/24, intended and observed gateway 192.168.10.1; gateway ping succeeds.",
            "Ping to 192.168.40.5 fails. R1 has no matching route and no default.",
            "Intended route: 192.168.40.0/24 via reachable next hop 10.0.0.2. Remaining path and return route are healthy."
          ],
          "fault": {
            "kind": "missing-route",
            "target": "R1",
            "destination": "192.168.40.5",
            "routes": [],
            "expected": {
              "prefix": "192.168.40.0/24",
              "nextHop": "10.0.0.2"
            }
          },
          "choices": [
            {
              "id": "route",
              "diagnosis": "missing-route",
              "target": "R1",
              "value": {
                "prefix": "192.168.40.0/24",
                "nextHop": "10.0.0.2"
              },
              "label": "Missing route → add 192.168.40.0/24 via 10.0.0.2"
            },
            {
              "id": "gateway",
              "diagnosis": "gateway",
              "target": "HOST-09",
              "value": "192.168.10.254",
              "label": "Wrong gateway → change HOST-09 gateway",
              "why": "The gateway matches the intended value and responds. Inspect R1's route to 192.168.40.5."
            }
          ],
          "hints": [
            "Follow the path past the last successful test.",
            "R1 has no matching route or default for 192.168.40.5.",
            "Install 192.168.40.0/24 via 10.0.0.2 on R1."
          ],
          "sources": [
            "rfc1812",
            "rfc792"
          ],
          "observations": [],
          "probes": [
            {
              "path": [
                "HOST-09",
                "192.168.10.1"
              ],
              "condition": "healthy"
            },
            {
              "path": [
                "HOST-09",
                "R1",
                "192.168.40.5"
              ],
              "condition": "restored"
            }
          ],
          "patchName": "Uplink Ranger"
        },
        {
          "id": "2.2",
          "crewReport": "Pump operator here. HOST-10 has gone quiet, but I can still ping the gateway from the desk beside it. Both desks are assigned to VLAN 20.",
          "title": "One host isolated",
          "alert": "HOST-10 cannot reach the gateway; another host can.",
          "path": "HOST-10 → SW-03 → gateway 192.168.20.1",
          "evidence": [
            "HOST-10: 192.168.20.10/24; intended and observed gateway 192.168.20.1.",
            "HOST-10 port expected VLAN 20; observed VLAN 30. Its gateway ping fails.",
            "Another host in VLAN 20 reaches 192.168.20.1. The gateway and remaining path are healthy."
          ],
          "fault": {
            "kind": "vlan",
            "target": "SW-03 HOST-10 port",
            "expected": 20,
            "observed": 30
          },
          "choices": [
            {
              "id": "vlan",
              "diagnosis": "vlan",
              "target": "SW-03 HOST-10 port",
              "value": 20,
              "label": "Wrong port VLAN → restore HOST-10 port to VLAN 20"
            },
            {
              "id": "router",
              "diagnosis": "gateway",
              "target": "router",
              "value": "replace",
              "label": "Failed gateway → replace the router gateway",
              "why": "Another host reaches the gateway. The direct mismatch is HOST-10's port VLAN; compare its values."
            }
          ],
          "hints": [
            "Compare observations from both hosts with their shared path.",
            "The gateway responds to the other host; HOST-10's port differs from its intended VLAN.",
            "Restore HOST-10's switch port to VLAN 20."
          ],
          "sources": [
            "vlan",
            "rfc792"
          ],
          "observations": [
            {
              "kind": "vlan",
              "target": "SW-03 HOST-10 port",
              "expected": 20,
              "observed": 30
            }
          ],
          "probes": [
            {
              "path": [
                "HOST-10",
                "SW-03",
                "192.168.20.1"
              ],
              "condition": "restored"
            },
            {
              "path": [
                "Peer on VLAN 20",
                "192.168.20.1"
              ],
              "condition": "healthy"
            }
          ],
          "patchName": "Pump Keeper"
        }
      ]
    },
    {
      "id": "level-3",
      "title": "Signal and Noise",
      "difficulty": 3,
      "outcome": "Distinguish root cause from symptoms",
      "briefing": "Choose the cause supported by the affected path, not an unrelated alert. Example: when /24 and default routes both match a destination, the more specific /24 route determines the next hop.",
      "sources": [
        "rfc1812",
        "vlan"
      ],
      "rounds": [
        {
          "id": "3.1",
          "title": "A misleading default",
          "alert": "R1 forwards the remote destination toward the wrong next hop.",
          "path": "R1 → selected next hop → 192.168.40.5",
          "evidence": [
            "Destination: 192.168.40.5. Installed routes: 0.0.0.0/0 via 10.0.0.1; 192.168.40.0/24 via 10.0.0.3.",
            "The intended next hop for 192.168.40.0/24 is 10.0.0.2. All shown next hops are reachable; the intended remaining path and return route are healthy.",
            "Connectivity to 192.168.40.5 fails."
          ],
          "fault": {
            "kind": "wrong-next-hop",
            "target": "R1",
            "destination": "192.168.40.5",
            "routes": [
              {
                "prefix": "0.0.0.0/0",
                "nextHop": "10.0.0.1"
              },
              {
                "prefix": "192.168.40.0/24",
                "nextHop": "10.0.0.3"
              }
            ],
            "expected": {
              "prefix": "192.168.40.0/24",
              "nextHop": "10.0.0.2"
            }
          },
          "choices": [
            {
              "id": "specific",
              "diagnosis": "wrong-next-hop",
              "target": "R1",
              "value": {
                "prefix": "192.168.40.0/24",
                "nextHop": "10.0.0.2"
              },
              "label": "Wrong specific-route next hop → set /24 next hop to 10.0.0.2"
            },
            {
              "id": "default",
              "diagnosis": "route",
              "target": "R1",
              "value": "default",
              "label": "Wrong default route → change the default route",
              "why": "192.168.40.0/24 is the more specific match, so it is selected instead of the default. Inspect its next hop."
            }
          ],
          "hints": [
            "Find the most specific route that matches the destination.",
            "192.168.40.0/24 is more specific than 0.0.0.0/0 and points to 10.0.0.3.",
            "Change the /24 route's next hop to 10.0.0.2."
          ],
          "sources": [
            "rfc1812"
          ],
          "observations": [],
          "probes": [
            {
              "path": [
                "R1",
                "10.0.0.3"
              ],
              "condition": "healthy"
            },
            {
              "path": [
                "R1",
                "192.168.40.5"
              ],
              "condition": "restored"
            }
          ],
          "patchName": "Dispatcher"
        },
        {
          "id": "3.2",
          "title": "Two alerts, one path",
          "alert": "HOST-11 cannot reach its gateway; an unrelated alert is also active.",
          "path": "HOST-11 → SW-04 → gateway 192.168.50.1; HOST-12 is on a separate path",
          "evidence": [
            "HOST-11: 192.168.50.11/24; expected and observed gateway 192.168.50.1.",
            "HOST-11 port expected VLAN 50; observed VLAN 60. Gateway ping fails.",
            "HOST-12 has a failed ping on an unrelated network with no shared path. Other HOST-11 path components are healthy."
          ],
          "fault": {
            "kind": "vlan",
            "target": "SW-04 HOST-11 port",
            "expected": 50,
            "observed": 60
          },
          "choices": [
            {
              "id": "vlan",
              "diagnosis": "vlan",
              "target": "SW-04 HOST-11 port",
              "value": 50,
              "label": "Wrong port VLAN → restore HOST-11 port to VLAN 50"
            },
            {
              "id": "gateway",
              "diagnosis": "gateway",
              "target": "HOST-11",
              "value": "192.168.50.254",
              "label": "Wrong gateway → change HOST-11 gateway",
              "why": "The gateway matches the intended 192.168.50.1. The separate alert does not explain the port mismatch; compare its VLAN values."
            }
          ],
          "hints": [
            "Focus on evidence from the affected path.",
            "HOST-11's port reports VLAN 60 but should be VLAN 50; HOST-12 is unrelated.",
            "Restore HOST-11's port to VLAN 50."
          ],
          "sources": [
            "vlan",
            "rfc792"
          ],
          "observations": [
            {
              "kind": "vlan",
              "target": "SW-04 HOST-11 port",
              "expected": 50,
              "observed": 60
            }
          ],
          "probes": [
            {
              "path": [
                "HOST-11",
                "SW-04",
                "192.168.50.1"
              ],
              "condition": "restored"
            },
            {
              "path": [
                "HOST-12",
                "Separate network"
              ],
              "condition": "unrelated"
            }
          ],
          "patchName": "Shelter Watch"
        }
      ]
    }
  ]
}
